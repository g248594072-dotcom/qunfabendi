# SaleSmartly（项目设置 → 企业开发设置）
SALESMARTLY_PROJECT_ID=你的项目ID
SALESMARTLY_API_TOKEN=你的API_Token
SALESMARTLY_BASE_URL=https://developer.salesmartly.com

# ========== 服务器部署建议 ==========
# 监听所有网卡（本机调试可改回 127.0.0.1）
UI_HOST=0.0.0.0
UI_PORT=3789
SERVER_MODE=1

# 访问控制台的账号密码（公网必须设置）
UI_USER=admin
UI_PASSWORD=请改成强密码

# 远程浏览器（同源路径，1Panel 只需反代 3789）
NOVNC_URL=/novnc/vnc.html?autoconnect=1&resize=remote&path=websockify

# 发送文案、间隔、每页上限等请在网页控制台里设置
# （会保存到 data/settings.json；服务器上请勾选「无头模式」）
