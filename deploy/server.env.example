# 复制到项目根目录改名为 .env 后填写密钥
# cp deploy/server.env.example .env

SALESMARTLY_PROJECT_ID=你的项目ID
SALESMARTLY_API_TOKEN=你的API_Token
SALESMARTLY_BASE_URL=https://developer.salesmartly.com

UI_HOST=0.0.0.0
UI_PORT=3789
SERVER_MODE=1

UI_USER=admin
UI_PASSWORD=请改成强密码

# 走 nginx 反代后，用 80 端口访问（当前服务器 IP）
NOVNC_URL=http://107.175.246.246/novnc/vnc.html?autoconnect=1&resize=remote&path=websockify

# 若已绑定域名，改成例如：
# NOVNC_URL=http://your.domain.com/novnc/vnc.html?autoconnect=1&resize=remote&path=websockify
