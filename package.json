{
  "name": "fb-page-broadcast",
  "version": "0.1.0",
  "private": true,
  "description": "从 SaleSmartly 拉客户，经 Meta 业务套件网页发送 Messenger 消息",
  "type": "module",
  "scripts": {
    "ui": "tsx src/server.ts",
    "login": "tsx src/cli.ts login",
    "sync:pages": "tsx src/cli.ts sync-pages",
    "detect:fb": "tsx src/cli.ts detect-fb-pages",
    "sync:blacklist": "tsx src/cli.ts sync-blacklist",
    "sync:contacts": "tsx src/cli.ts sync-contacts",
    "send": "tsx src/cli.ts send",
    "send:dry": "tsx src/cli.ts send --dry-run",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.51.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
